{
  "name": "checkpoint",
  "description": "Helix-inspired bounded checkpoint: plan, implement, verify, two independent reviews, approval.",
  "version": "1.0",
  "entry": "plan",
  "tags": [
    "helix",
    "checkpoint",
    "strict"
  ],
  "defaults": {},
  "stages": [
    {
      "id": "plan",
      "kind": "agent",
      "title": "Define one small checkpoint and acceptance criteria",
      "on_success": "approve-plan",
      "on_failure": "blocked",
      "role": "planner",
      "instruction": "Define the smallest coherent checkpoint that advances the task. State acceptance criteria before implementation.",
      "max_attempts": 1
    },
    {
      "id": "approve-plan",
      "kind": "human",
      "title": "Approve checkpoint plan",
      "on_success": "implement",
      "on_failure": "blocked",
      "metadata": {
        "always": true
      }
    },
    {
      "id": "implement",
      "kind": "agent",
      "title": "Implement bounded change",
      "on_success": "verify",
      "on_failure": "blocked",
      "role": "implementer",
      "instruction": "Implement only the requested bounded change. Inspect the repository first; preserve unrelated changes.",
      "max_attempts": 3
    },
    {
      "id": "verify",
      "kind": "gate",
      "title": "Run strict deterministic verification",
      "on_success": "review",
      "on_failure": "implement",
      "gate_profile": "strict"
    },
    {
      "id": "review",
      "kind": "review",
      "title": "Independent review (2 reviewers)",
      "on_success": "approve-final",
      "on_failure": "implement",
      "reviewers": 2
    },
    {
      "id": "approve-final",
      "kind": "human",
      "title": "Human/risk approval",
      "on_success": "done",
      "on_failure": "blocked",
      "metadata": {
        "always": true
      }
    }
  ]
}
