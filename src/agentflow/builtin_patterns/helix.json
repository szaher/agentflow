{
  "name": "helix",
  "description": "High-confidence Helix-style convergence loop with strict gates and two isolated reviewers.",
  "version": "1.0",
  "entry": "plan",
  "tags": [
    "helix",
    "migration",
    "high-confidence"
  ],
  "defaults": {},
  "stages": [
    {
      "id": "plan",
      "kind": "agent",
      "title": "Propose checkpoint and acceptance criteria",
      "on_success": "approve-plan",
      "on_failure": "blocked",
      "role": "planner",
      "instruction": "Propose one bounded checkpoint. Use the repository/reference as the source of truth. State explicit acceptance criteria.",
      "max_attempts": 1
    },
    {
      "id": "approve-plan",
      "kind": "human",
      "title": "Approve checkpoint plan",
      "on_success": "implement",
      "on_failure": "blocked",
      "metadata": {
        "always": true
      }
    },
    {
      "id": "implement",
      "kind": "agent",
      "title": "Implement bounded change",
      "on_success": "verify",
      "on_failure": "blocked",
      "role": "implementer",
      "instruction": "Implement only the requested bounded change. Inspect the repository first; preserve unrelated changes.",
      "max_attempts": 4
    },
    {
      "id": "verify",
      "kind": "gate",
      "title": "Run strict deterministic verification",
      "on_success": "review",
      "on_failure": "implement",
      "gate_profile": "strict"
    },
    {
      "id": "review",
      "kind": "review",
      "title": "Independent review (2 reviewers)",
      "on_success": "approve-final",
      "on_failure": "implement",
      "reviewers": 2
    },
    {
      "id": "approve-final",
      "kind": "human",
      "title": "Human/risk approval",
      "on_success": "done",
      "on_failure": "blocked",
      "metadata": {
        "always": true
      }
    }
  ]
}
