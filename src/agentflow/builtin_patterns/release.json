{
  "name": "release",
  "description": "Release-readiness workflow with strict verification and human approval.",
  "version": "1.0",
  "entry": "prepare",
  "tags": [
    "release",
    "human-gate"
  ],
  "defaults": {},
  "stages": [
    {
      "id": "prepare",
      "kind": "agent",
      "title": "Prepare release metadata and readiness checklist",
      "on_success": "verify",
      "on_failure": "blocked",
      "role": "release-manager",
      "instruction": "Check versioning, changelog/release notes, migrations, compatibility notes, packaging, and release configuration. Do not publish externally.",
      "max_attempts": 2
    },
    {
      "id": "verify",
      "kind": "gate",
      "title": "Run strict deterministic verification",
      "on_success": "review",
      "on_failure": "prepare",
      "gate_profile": "strict"
    },
    {
      "id": "review",
      "kind": "review",
      "title": "Independent review (1 reviewer)",
      "on_success": "approve",
      "on_failure": "prepare",
      "reviewers": 1
    },
    {
      "id": "approve",
      "kind": "human",
      "title": "Human/risk approval",
      "on_success": "done",
      "on_failure": "blocked",
      "metadata": {
        "always": true
      }
    }
  ]
}
