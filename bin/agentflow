#!/usr/bin/env python3
from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import textwrap
from typing import Any

KIT_ROOT = Path(__file__).resolve().parent.parent
TEMPLATE_ROOT = KIT_ROOT / "template"


def eprint(*args: Any) -> None:
    print(*args, file=sys.stderr)


def run(cmd: str | list[str], cwd: Path, *, capture: bool = False, env: dict[str, str] | None = None) -> subprocess.CompletedProcess[str]:
    if isinstance(cmd, str):
        return subprocess.run(cmd, cwd=cwd, shell=True, text=True, capture_output=capture, env=env)
    return subprocess.run(cmd, cwd=cwd, text=True, capture_output=capture, env=env)


def git_root(path: Path) -> Path:
    p = path.resolve()
    cp = run(["git", "rev-parse", "--show-toplevel"], p, capture=True)
    if cp.returncode == 0:
        return Path(cp.stdout.strip()).resolve()
    return p


def slugify(s: str) -> str:
    s = s.lower().strip()
    s = re.sub(r"[^a-z0-9]+", "-", s).strip("-")
    return s[:64] or "checkpoint"


def now_iso() -> str:
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat()


def load_json(path: Path, default: Any = None) -> Any:
    if not path.exists():
        return default
    return json.loads(path.read_text(encoding="utf-8"))


def write_json(path: Path, obj: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(obj, indent=2, sort_keys=False) + "\n", encoding="utf-8")


def project_config(root: Path) -> dict[str, Any]:
    cfg = load_json(root / ".agentflow" / "config.json")
    if not cfg:
        raise SystemExit("No .agentflow/config.json. Run: agentflow bootstrap .")
    return cfg


def evidence_path(rel: str) -> bool:
    # Machine bookkeeping changes as evidence is recorded; it must not invalidate
    # the evidence it records. Human-authored plans/config remain fingerprinted.
    return not rel.startswith(".agentflow/checkpoints/")


def worktree_fingerprint(root: Path) -> str:
    cp = run(["git", "diff", "--binary", "HEAD"], root, capture=True)
    if cp.returncode != 0:
        cp = run(["git", "diff", "--binary"], root, capture=True)
    untracked = run(["git", "ls-files", "--others", "--exclude-standard", "-z"], root, capture=True)
    h=hashlib.sha256(); h.update(cp.stdout.encode()); h.update(b"\nUNTRACKED\n")
    for rel in sorted(x for x in untracked.stdout.split("\0") if x):
        h.update(rel.encode()); h.update(b"\0")
        fp=root/rel
        if fp.is_file():
            try: h.update(fp.read_bytes())
            except OSError: h.update(b"<unreadable>")
        elif fp.is_symlink():
            try: h.update(os.readlink(fp).encode())
            except OSError: h.update(b"<unreadable-link>")
        h.update(b"\0")
    return h.hexdigest()


def git_diff_fingerprint(root: Path) -> str:
    cp = run(["git", "diff", "--binary", "HEAD", "--", ".", ":(exclude).agentflow/checkpoints/**"], root, capture=True)
    if cp.returncode != 0:
        cp = run(["git", "diff", "--binary", "--", ".", ":(exclude).agentflow/checkpoints/**"], root, capture=True)
    untracked = run(["git", "ls-files", "--others", "--exclude-standard", "-z"], root, capture=True)
    h = hashlib.sha256()
    h.update(cp.stdout.encode())
    h.update(b"\nUNTRACKED\n")
    for rel in sorted(x for x in untracked.stdout.split("\0") if x and evidence_path(x)):
        h.update(rel.encode()); h.update(b"\0")
        fp = root / rel
        if fp.is_file():
            try: h.update(fp.read_bytes())
            except OSError: h.update(b"<unreadable>")
        elif fp.is_symlink():
            try: h.update(os.readlink(fp).encode())
            except OSError: h.update(b"<unreadable-link>")
        h.update(b"\0")
    return h.hexdigest()


def changed_files(root: Path) -> list[str]:
    seen: list[str] = []
    for args in (["git", "diff", "--name-only", "HEAD"], ["git", "ls-files", "--others", "--exclude-standard"]):
        cp = run(args, root, capture=True)
        if cp.returncode == 0:
            for line in cp.stdout.splitlines():
                if line and line not in seen:
                    seen.append(line)
    return seen


def detect_project(root: Path) -> dict[str, Any]:
    kinds: list[str] = []
    gates: dict[str, list[dict[str, Any]]] = {"fast": [], "standard": [], "strict": []}

    def add(profile: str, name: str, command: str, required: bool = True) -> None:
        item = {"name": name, "command": command, "required": required}
        if not any(x["name"] == name for x in gates[profile]):
            gates[profile].append(item)

    for profile in gates:
        add(profile, "git-diff-check", "git diff --check")

    pkg = root / "package.json"
    if pkg.exists():
        kinds.append("node")
        try:
            scripts = json.loads(pkg.read_text())["scripts"]
        except Exception:
            scripts = {}
        pm = "npm"
        if (root / "pnpm-lock.yaml").exists(): pm = "pnpm"
        elif (root / "yarn.lock").exists(): pm = "yarn"
        elif (root / "bun.lockb").exists() or (root / "bun.lock").exists(): pm = "bun"
        def scmd(name: str) -> str:
            return f"{pm} run {name}" if pm != "yarn" else f"yarn {name}"
        if "lint" in scripts:
            add("fast", "lint", scmd("lint")); add("standard", "lint", scmd("lint")); add("strict", "lint", scmd("lint"))
        for key in ("typecheck", "type-check", "check-types"):
            if key in scripts:
                add("standard", "types", scmd(key)); add("strict", "types", scmd(key)); break
        if "test" in scripts:
            add("standard", "tests", scmd("test")); add("strict", "tests", scmd("test"))
        if "build" in scripts:
            add("strict", "build", scmd("build"))

    pyproject = root / "pyproject.toml"
    if pyproject.exists() or (root / "setup.py").exists() or (root / "requirements.txt").exists():
        kinds.append("python")
        txt = pyproject.read_text(encoding="utf-8") if pyproject.exists() else ""
        if "[tool.ruff" in txt:
            for p in gates: add(p, "ruff", "ruff check .")
            if "[tool.ruff.format" in txt or "ruff" in txt:
                add("standard", "format", "ruff format --check .", False); add("strict", "format", "ruff format --check .", False)
        elif "[tool.black" in txt:
            add("standard", "format", "black --check .", False); add("strict", "format", "black --check .", False)
        if "[tool.mypy" in txt:
            add("standard", "mypy", "mypy ."); add("strict", "mypy", "mypy .")
        if "[tool.pyright" in txt:
            add("standard", "pyright", "pyright"); add("strict", "pyright", "pyright")
        if (root / "tests").exists() or "pytest" in txt:
            add("standard", "pytest", "pytest -q"); add("strict", "pytest", "pytest -q")

    if (root / "go.mod").exists():
        kinds.append("go")
        add("fast", "gofmt", "test -z \"$(gofmt -l .)\"")
        for p in ("standard", "strict"):
            add(p, "gofmt", "test -z \"$(gofmt -l .)\""); add(p, "go-vet", "go vet ./..."); add(p, "go-test", "go test ./...")

    if (root / "Cargo.toml").exists():
        kinds.append("rust")
        add("fast", "cargo-fmt", "cargo fmt --check")
        for p in ("standard", "strict"):
            add(p, "cargo-fmt", "cargo fmt --check"); add(p, "cargo-test", "cargo test")
        add("strict", "cargo-clippy", "cargo clippy --all-targets -- -D warnings", False)

    if (root / "pom.xml").exists() or (root / "mvnw").exists():
        kinds.append("maven")
        mvn = "./mvnw" if (root / "mvnw").exists() else "mvn"
        add("standard", "maven-test", f"{mvn} test"); add("strict", "maven-verify", f"{mvn} verify")

    if (root / "gradlew").exists() or (root / "build.gradle").exists() or (root / "build.gradle.kts").exists():
        kinds.append("gradle")
        gradle = "./gradlew" if (root / "gradlew").exists() else "gradle"
        add("standard", "gradle-test", f"{gradle} test"); add("strict", "gradle-check", f"{gradle} check")

    if (root / "Makefile").exists():
        kinds.append("make")
        text = (root / "Makefile").read_text(encoding="utf-8", errors="ignore")
        if re.search(r"(?m)^check\s*:", text): add("strict", "make-check", "make check")
        elif re.search(r"(?m)^test\s*:", text): add("strict", "make-test", "make test")

    return {"detected": sorted(set(kinds)) or ["generic"], "gates": gates}


def bootstrap(target: Path, force: bool = False, init_git: bool = False) -> None:
    target=target.resolve(); target.mkdir(parents=True,exist_ok=True)
    probe=run(["git","rev-parse","--show-toplevel"],target,capture=True)
    if probe.returncode!=0:
        if not init_git:
            raise SystemExit("Agentflow requires a Git repository. Run `git init` first or use `agentflow bootstrap . --init-git`.")
        cp=run(["git","init"],target,capture=True)
        if cp.returncode!=0: raise SystemExit(cp.stderr or "git init failed")
    root = git_root(target)
    conflicts: list[str] = []
    for src in TEMPLATE_ROOT.rglob("*"):
        if src.is_dir():
            continue
        rel = src.relative_to(TEMPLATE_ROOT)
        dst = root / rel
        dst.parent.mkdir(parents=True, exist_ok=True)
        if dst.exists() and not force:
            conflicts.append(str(rel)); continue
        shutil.copy2(src, dst)
    cfg_path = root / ".agentflow" / "config.json"
    detected = detect_project(root)
    cfg = load_json(cfg_path, {}) or {}
    cfg["project"] = {"root": ".", "detected": detected["detected"]}
    cfg["gates"] = detected["gates"]
    write_json(cfg_path, cfg)
    gi = root / ".gitignore"
    marker = "# Agentflow runtime"
    existing = gi.read_text(encoding="utf-8") if gi.exists() else ""
    if marker not in existing:
        with gi.open("a", encoding="utf-8") as f:
            if existing and not existing.endswith("\n"): f.write("\n")
            f.write("\n# Agentflow runtime\n.agentflow/runtime/\n")
    if conflicts:
        (root / ".agentflow" / "bootstrap-conflicts.txt").write_text("\n".join(conflicts)+"\n")
    print(f"Bootstrapped Agentflow in {root}")
    print("Detected:", ", ".join(detected["detected"]))
    if conflicts:
        print(f"Preserved {len(conflicts)} existing file(s); see .agentflow/bootstrap-conflicts.txt")


def doctor(target: Path) -> int:
    root = git_root(target)
    print(f"Project: {root}")
    print(f"Python:  {sys.version.split()[0]}")
    ok = True
    for name in ("git", "claude", "codex", "pi"):
        exe = shutil.which(name)
        if not exe:
            print(f"{name:7} MISSING")
            if name == "git": ok = False
            continue
        cp = run([name, "--version"], root, capture=True)
        version = (cp.stdout or cp.stderr).strip().splitlines()[0] if (cp.stdout or cp.stderr) else exe
        print(f"{name:7} OK  {version}")
    cfg = root / ".agentflow" / "config.json"
    print(f"config  {'OK' if cfg.exists() else 'MISSING'}  {cfg}")
    skills = root / ".agents" / "skills"
    print(f"skills  {'OK' if skills.exists() else 'MISSING'}  {skills}")
    claude = root / ".claude" / "settings.json"
    print(f"claude  {'OK' if claude.exists() else 'MISSING'}  project hooks/settings")
    pi = root / ".pi" / "settings.json"
    print(f"pi      {'OK' if pi.exists() else 'MISSING'}  project settings")
    return 0 if ok else 2


def new_checkpoint(title: str, target: Path) -> Path:
    root = git_root(target)
    project_config(root)
    stamp = dt.datetime.now().strftime("%Y%m%d-%H%M")
    cid = f"{stamp}-{slugify(title)}"
    md = root / "docs" / "exec-plans" / "active" / f"{cid}.md"
    md.parent.mkdir(parents=True, exist_ok=True)
    md.write_text(textwrap.dedent(f"""\
    # {title}

    Checkpoint ID: `{cid}`

    ## Goal

    {title}

    ## Scope

    - TODO: list the smallest set of files/components expected to change.

    ## Acceptance criteria

    - [ ] TODO: observable behavior criterion.
    - [ ] TODO: regression/compatibility criterion.
    - [ ] Deterministic project gates pass.

    ## Out of scope

    - TODO: state what this checkpoint must not attempt.

    ## Evidence

    Record commands, test output, screenshots, or other evidence here or under `.agentflow/runtime/{cid}/`.
    """), encoding="utf-8")
    state = {
        "id": cid, "title": title, "status": "planned", "created_at": now_iso(),
        "attempts": 0, "gate_status": "not_run", "review_status": "not_run",
        "risk": None, "human_approved": False, "plan_file": str(md.relative_to(root)),
    }
    sp = root / ".agentflow" / "checkpoints" / f"{cid}.json"
    write_json(sp, state)
    write_json(root / ".agentflow" / "runtime" / "active.json", {"checkpoint": cid})
    print(cid)
    print(md)
    return sp


def active_checkpoint(root: Path) -> tuple[Path, dict[str, Any]]:
    active = load_json(root / ".agentflow" / "runtime" / "active.json", {}) or {}
    cid = active.get("checkpoint")
    if not cid:
        raise SystemExit("No active checkpoint. Run: agentflow new \"...\" .")
    sp = root / ".agentflow" / "checkpoints" / f"{cid}.json"
    st = load_json(sp)
    if not st:
        raise SystemExit(f"Active checkpoint state not found: {sp}")
    return sp, st


def run_gates(target: Path, profile: str) -> int:
    root = git_root(target)
    cfg = project_config(root)
    gates = cfg.get("gates", {}).get(profile, [])
    if not gates:
        print(f"No gates configured for profile {profile}")
        return 0
    try:
        sp, st = active_checkpoint(root)
    except SystemExit:
        sp = None; st = None
    runtime_dir = root / ".agentflow" / "runtime" / "gates"
    runtime_dir.mkdir(parents=True, exist_ok=True)
    results=[]; overall=True
    for gate in gates:
        name=gate["name"]; command=gate["command"]; required=bool(gate.get("required", True))
        print(f"\n==> {name}: {command}")
        cp=run(command, root, capture=True)
        if cp.stdout: print(cp.stdout, end="" if cp.stdout.endswith("\n") else "\n")
        if cp.stderr: eprint(cp.stderr, end="" if cp.stderr.endswith("\n") else "\n")
        passed=cp.returncode==0
        print(f"<== {name}: {'PASS' if passed else 'FAIL'}{' (optional)' if not required else ''}")
        results.append({"name":name,"command":command,"required":required,"returncode":cp.returncode,"passed":passed})
        if required and not passed: overall=False
    record={"profile":profile,"passed":overall,"at":now_iso(),"fingerprint":git_diff_fingerprint(root),"results":results}
    write_json(runtime_dir / "latest.json", record)
    if st is not None and sp is not None:
        st["gate_status"]="pass" if overall else "fail"; st["gate_profile"]=profile; st["gate_fingerprint"]=record["fingerprint"]; st["updated_at"]=now_iso(); write_json(sp, st)
    return 0 if overall else 1


def risk_assessment(root: Path) -> dict[str, Any]:
    files=changed_files(root)
    semantic_files=[f for f in files if not f.startswith(".agentflow/checkpoints/") and not f.startswith("docs/exec-plans/")]
    high_patterns=[
        r"(^|/)(auth|security|iam|rbac|payments?|billing|secrets?|crypto)(/|$)",
        r"(^|/)(migrations?|alembic|terraform|infra|deploy|k8s|kubernetes|helm)(/|$)",
        r"^\.github/workflows/", r"(^|/)(Dockerfile|Containerfile)$", r"(^|/)(package-lock\.json|pnpm-lock\.yaml|yarn\.lock|uv\.lock|poetry\.lock|Cargo\.lock)$",
    ]
    reasons=[]
    for f in semantic_files:
        for pat in high_patterns:
            if re.search(pat, f, re.I): reasons.append(f"sensitive path: {f}"); break
    if reasons: level="high"
    elif any(not re.search(r"(^|/)(docs?|tests?|testdata|examples?)(/|$)|\.(md|rst)$", f, re.I) for f in semantic_files): level="medium"
    else: level="low"
    return {"level":level,"files":files,"reasons":reasons or (["source/code changes"] if level=="medium" else ["low-risk documentation/test-only changes or no semantic changes"])}


def do_risk(target: Path) -> int:
    root=git_root(target); project_config(root); r=risk_assessment(root)
    print(json.dumps(r, indent=2))
    try:
        sp, st=active_checkpoint(root); st["risk"]=r; st["updated_at"]=now_iso(); write_json(sp,st)
    except SystemExit: pass
    return 0


def harness_command(name: str, prompt: str) -> list[str]:
    env_name=f"AGENTFLOW_{name.upper()}_CMD"
    raw=os.environ.get(env_name)
    if raw: return shlex.split(raw)+[prompt]
    defaults={"claude":["claude","-p"],"codex":["codex","exec"],"pi":["pi","-p"]}
    if name not in defaults: raise SystemExit(f"Unknown harness: {name}")
    return defaults[name]+[prompt]


def invoke_harness(name: str, prompt: str, root: Path, logfile: Path | None = None) -> subprocess.CompletedProcess[str]:
    exe=harness_command(name,prompt)
    if not shutil.which(exe[0]):
        raise SystemExit(f"Harness '{name}' is not installed or not on PATH ({exe[0]}). Run agentflow doctor .")
    env=os.environ.copy(); env["AGENTFLOW_HARNESS"]=name
    cp=run(exe, root, capture=True, env=env)
    if logfile:
        logfile.parent.mkdir(parents=True,exist_ok=True)
        logfile.write_text((cp.stdout or "")+("\nSTDERR\n"+cp.stderr if cp.stderr else ""),encoding="utf-8")
    if cp.stdout: print(cp.stdout)
    if cp.stderr: eprint(cp.stderr)
    return cp


def checkpoint_prompt(root: Path, st: dict[str, Any], role: str) -> str:
    plan=(root/st["plan_file"]).read_text(encoding="utf-8")
    if role=="implement":
        return f"""You are the implementation worker for one bounded Agentflow checkpoint. Read AGENTS.md and obey repository instructions. Implement ONLY this checkpoint. Do not broaden scope. Do not weaken, delete, skip, or rewrite tests merely to make them pass. Run appropriate fast checks before finishing. If blocked, explain the root cause rather than inventing a workaround.\n\nCHECKPOINT:\n{plan}\n"""
    if role=="review":
        return f"""You are an independent reviewer. DO NOT edit, write, format, or modify any project file. Inspect the current git diff and the checkpoint below. Look for correctness bugs, requirement gaps, security/reliability issues, hidden scope creep, test gaps, and brittle shortcuts. Treat passing tests as evidence, not proof. End your response with exactly one machine-readable line in this form:\nAGENTFLOW_REVIEW_JSON={{\"verdict\":\"pass|fail\",\"summary\":\"short text\",\"findings\":[\"...\"]}}\nUse pass only when there are no blocking findings.\n\nCHECKPOINT:\n{plan}\n"""
    raise ValueError(role)


def parse_review(text: str) -> dict[str, Any] | None:
    for line in reversed(text.splitlines()):
        if line.startswith("AGENTFLOW_REVIEW_JSON="):
            try: return json.loads(line.split("=",1)[1])
            except Exception: return None
    return None


def do_review(target: Path, harness: str) -> int:
    root=git_root(target); sp,st=active_checkpoint(root)
    before=worktree_fingerprint(root)
    out=root/".agentflow"/"runtime"/st["id"]/(f"review-{harness}.log")
    cp=invoke_harness(harness,checkpoint_prompt(root,st,"review"),root,out)
    after=worktree_fingerprint(root)
    if before!=after:
        st["review_status"]="invalid-mutated-worktree"; st["updated_at"]=now_iso(); write_json(sp,st)
        eprint("Reviewer changed the worktree. Review rejected. Agentflow will not auto-revert changes.")
        return 2
    review=parse_review(cp.stdout or "")
    if cp.returncode!=0 or not review or review.get("verdict") not in {"pass","fail"}:
        st["review_status"]="invalid"; st["updated_at"]=now_iso(); write_json(sp,st)
        eprint("Reviewer did not return a valid Agentflow review verdict.")
        return 2
    evidence_fp=git_diff_fingerprint(root)
    st["review_status"]=review["verdict"]; st["review"]=review; st["review_harness"]=harness; st["review_fingerprint"]=evidence_fp; st["updated_at"]=now_iso(); write_json(sp,st)
    return 0 if review["verdict"]=="pass" else 1


def do_cycle(target: Path, worker: str, reviewer: str, max_attempts: int, profile: str) -> int:
    root=git_root(target); sp,st=active_checkpoint(root)
    for attempt in range(1,max_attempts+1):
        st=load_json(sp); st["status"]="implementing"; st["attempts"]=int(st.get("attempts",0))+1; st["updated_at"]=now_iso(); write_json(sp,st)
        print(f"\n### Attempt {attempt}/{max_attempts}: worker={worker}")
        cp=invoke_harness(worker,checkpoint_prompt(root,st,"implement"),root,root/".agentflow"/"runtime"/st["id"]/f"attempt-{attempt}-{worker}.log")
        if cp.returncode!=0:
            print("Worker process failed; retrying if attempts remain.")
            continue
        if run_gates(root,profile)!=0:
            print("Deterministic gates failed; returning checkpoint to worker.")
            continue
        print(f"\n### Independent review: reviewer={reviewer}")
        if do_review(root,reviewer)!=0:
            print("Independent review failed; returning checkpoint to worker.")
            continue
        st=load_json(sp); r=risk_assessment(root); st["risk"]=r; st["status"]="ready-for-approval"; st["updated_at"]=now_iso(); write_json(sp,st)
        print(f"Checkpoint ready for approval. Risk: {r['level']}")
        if r["level"]=="high": print("Human approval is required: agentflow approve . --human")
        else: print("Approve with: agentflow approve .  (add --human to record explicit human review)")
        return 0
    st=load_json(sp); st["status"]="blocked"; st["blocked_reason"]="maximum attempts exhausted"; st["updated_at"]=now_iso(); write_json(sp,st)
    eprint("Checkpoint blocked: maximum attempts exhausted. Replan or intervene; Agentflow will not loop indefinitely.")
    return 1


def do_approve(target: Path, human: bool) -> int:
    root=git_root(target); sp,st=active_checkpoint(root)
    fp=git_diff_fingerprint(root)
    if st.get("gate_status")!="pass" or st.get("gate_fingerprint")!=fp:
        eprint("Cannot approve: deterministic gates are missing, failed, or stale for the current diff.")
        return 2
    if st.get("review_status")!="pass" or st.get("review_fingerprint")!=fp:
        eprint("Cannot approve: independent review is missing, failed, or stale for the current diff.")
        return 2
    r=st.get("risk") or risk_assessment(root)
    if r.get("level")=="high" and not human:
        eprint("High-risk checkpoint requires explicit human approval: agentflow approve . --human")
        return 2
    st["human_approved"]=bool(human); st["status"]="accepted"; st["accepted_at"]=now_iso(); st["evidence_fingerprint"]=fp; write_json(sp,st)
    plan=root/st["plan_file"]
    completed=root/"docs"/"exec-plans"/"completed"/plan.name
    completed.parent.mkdir(parents=True,exist_ok=True)
    if plan.exists(): shutil.move(str(plan),str(completed)); st["plan_file"]=str(completed.relative_to(root))
    st["accepted_fingerprint"]=git_diff_fingerprint(root); write_json(sp,st)
    print(f"Accepted checkpoint {st['id']} ({'human approved' if human else 'policy approved'})")
    return 0


def do_status(target: Path) -> int:
    root=git_root(target); project_config(root)
    try: _,st=active_checkpoint(root)
    except SystemExit as ex: print(ex); return 1
    print(json.dumps(st,indent=2))
    fp=git_diff_fingerprint(root)
    if st.get("status")=="accepted":
        if st.get("accepted_fingerprint") and st["accepted_fingerprint"]!=fp:
            print("WARNING: worktree changed after checkpoint acceptance")
    else:
        if st.get("gate_fingerprint") and st["gate_fingerprint"]!=fp: print("WARNING: gate evidence is stale for the current diff")
        if st.get("review_fingerprint") and st["review_fingerprint"]!=fp: print("WARNING: review evidence is stale for the current diff")
    return 0


def hook_stop(target: Path) -> int:
    # Claude Code passes Stop JSON on stdin. Block only once; on the continuation,
    # stop_hook_active=true lets Claude stop so this cannot become an infinite loop.
    try: payload=json.load(sys.stdin)
    except Exception: return 0
    if payload.get("stop_hook_active") is True: return 0
    root=git_root(target)
    try: _,st=active_checkpoint(root)
    except SystemExit: return 0
    if st.get("status") not in {"implementing","planned"}: return 0
    fp=git_diff_fingerprint(root)
    gate_ok=st.get("gate_status")=="pass" and st.get("gate_fingerprint")==fp
    if not gate_ok:
        print(json.dumps({"decision":"block","reason":"Active Agentflow checkpoint has no passing, current deterministic gate evidence. Run `agentflow gates . --profile standard`, fix failures, then finish."}))
    return 0


def sync_skills(target: Path) -> int:
    root=git_root(target)
    shared=root/".agents"/"skills"
    dest=root/".claude"/"skills"
    if not shared.exists():
        eprint("Missing .agents/skills. Run agentflow bootstrap .")
        return 2
    dest.mkdir(parents=True,exist_ok=True)
    shared_names=set()
    for src in shared.iterdir():
        if not src.is_dir(): continue
        shared_names.add(src.name)
        out=dest/src.name
        if out.exists(): shutil.rmtree(out)
        shutil.copytree(src,out)
    for old in list(dest.iterdir()):
        if old.is_dir() and old.name not in shared_names:
            shutil.rmtree(old)
    print(f"Synced {len(shared_names)} shared skills into .claude/skills")
    return 0


def main() -> int:
    p=argparse.ArgumentParser(prog="agentflow",description="Harness-neutral agentic development control loop")
    sub=p.add_subparsers(dest="cmd",required=True)
    b=sub.add_parser("bootstrap"); b.add_argument("target",nargs="?",default="."); b.add_argument("--force",action="store_true"); b.add_argument("--init-git",action="store_true")
    d=sub.add_parser("doctor"); d.add_argument("target",nargs="?",default=".")
    de=sub.add_parser("detect"); de.add_argument("target",nargs="?",default=".")
    n=sub.add_parser("new"); n.add_argument("title"); n.add_argument("target",nargs="?",default=".")
    g=sub.add_parser("gates"); g.add_argument("target",nargs="?",default="."); g.add_argument("--profile",choices=["fast","standard","strict"],default="standard")
    r=sub.add_parser("risk"); r.add_argument("target",nargs="?",default=".")
    s=sub.add_parser("status"); s.add_argument("target",nargs="?",default=".")
    rv=sub.add_parser("review"); rv.add_argument("target",nargs="?",default="."); rv.add_argument("--harness",choices=["claude","codex","pi"],required=True)
    cy=sub.add_parser("cycle"); cy.add_argument("target",nargs="?",default="."); cy.add_argument("--worker",choices=["claude","codex","pi"],required=True); cy.add_argument("--reviewer",choices=["claude","codex","pi"],required=True); cy.add_argument("--max-attempts",type=int,default=3); cy.add_argument("--profile",choices=["fast","standard","strict"],default="standard")
    ap=sub.add_parser("approve"); ap.add_argument("target",nargs="?",default="."); ap.add_argument("--human",action="store_true")
    ss=sub.add_parser("sync-skills"); ss.add_argument("target",nargs="?",default=".")
    hs=sub.add_parser("hook-stop"); hs.add_argument("target",nargs="?",default=".")
    args=p.parse_args()
    target=Path(getattr(args,"target","."))
    if args.cmd=="bootstrap": bootstrap(target,args.force,args.init_git); return 0
    if args.cmd=="doctor": return doctor(target)
    if args.cmd=="detect": print(json.dumps(detect_project(git_root(target)),indent=2)); return 0
    if args.cmd=="new": new_checkpoint(args.title,target); return 0
    if args.cmd=="gates": return run_gates(target,args.profile)
    if args.cmd=="risk": return do_risk(target)
    if args.cmd=="status": return do_status(target)
    if args.cmd=="review": return do_review(target,args.harness)
    if args.cmd=="cycle":
        if args.max_attempts<1 or args.max_attempts>10: raise SystemExit("--max-attempts must be between 1 and 10")
        return do_cycle(target,args.worker,args.reviewer,args.max_attempts,args.profile)
    if args.cmd=="approve": return do_approve(target,args.human)
    if args.cmd=="sync-skills": return sync_skills(target)
    if args.cmd=="hook-stop": return hook_stop(target)
    return 2

if __name__=="__main__":
    raise SystemExit(main())
